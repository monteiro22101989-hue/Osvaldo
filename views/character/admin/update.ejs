<%- include("../../partials/header") %>
<%- include("../../partials/navbar") %>
<body>

    <div class="chapter-edit-page">

        <div class="chapter-edit-container">

            <!-- Page heading -->
            <div class="chapter-edit-header">
                <span class="chapter-edit-eyebrow">
                    CHARACTER MANAGEMENT
                </span>

                <h1>Edit Character</h1>

                <p>
                    Update your character's details, personality and story.
                </p>
            </div>

            <!-- Edit character form -->
            <div class="chapter-edit-panel">

                <form action="/character/save" method="POST">

                    <!-- Character name and nickname -->
                    <div class="chapter-edit-grid">

                        <div class="chapter-edit-group">
                            <label for="name">
                                Name
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="name"
                                name="name"
                                value="<%= characters.name %>"
                                placeholder="Enter the character's name"
                                required
                            >
                        </div>

                        <div class="chapter-edit-group">
                            <label for="nickname">
                                Nickname
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="nickname"
                                name="nickname"
                                value="<%= characters.nickname %>"
                                placeholder="Enter the character's nickname"
                            >
                        </div>

                    </div>

                    <!-- Character state on story -->
                    <div class="chapter-edit-group">
                        <label for="stateStory">
                            State on Story
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="stateStory"
                            name="stateStory"
                            value="<%= characters.state_on_story %>"
                            placeholder="Enter the character's state in the story"
                        >
                    </div>

                    <!-- Description -->
                    <div class="chapter-edit-group chapter-edit-content">
                        <label for="description">
                            Description
                        </label>

                        <textarea
                            class="form-control"
                            id="description"
                            name="description"
                        ><%= characters.description %></textarea>
                    </div>

                    <!-- Appearance -->
                    <div class="chapter-edit-group chapter-edit-content">
                        <label for="appearance">
                            Appearance
                        </label>

                        <textarea
                            class="form-control"
                            id="appearance"
                            name="appearance"
                        ><%= characters.appearance %></textarea>
                    </div>

                    <!-- Personality -->
                    <div class="chapter-edit-group chapter-edit-content">
                        <label for="personality">
                            Personality
                        </label>

                        <textarea
                            class="form-control"
                            id="personality"
                            name="personality"
                        ><%= characters.personality %></textarea>
                    </div>

                    <!-- Story -->
                    <div class="chapter-edit-group chapter-edit-content">
                        <label for="story">
                            Story
                        </label>

                        <textarea
                            class="form-control"
                            id="story"
                            name="story"
                        ><%= characters.story %></textarea>
                    </div>

                    <!-- Goals -->
                    <div class="chapter-edit-group chapter-edit-content">
                        <label for="goals">
                            Goals
                        </label>

                        <textarea
                            class="form-control"
                            id="goals"
                            name="goals"
                        ><%= characters.goals %></textarea>
                    </div>

                    <!-- State -->
                    <div class="chapter-edit-group chapter-edit-content">
                        <label for="state">
                            State
                        </label>

                        <textarea
                            class="form-control"
                            id="state"
                            name="state"
                        ><%= characters.state %></textarea>
                    </div>

                    <!-- Character ID -->
                    <input
                        type="hidden"
                        name="id"
                        value="<%= characters.id %>"
                    >

                    <!-- Form actions -->
                    <div class="chapter-edit-actions">

                        <a
                            href="/character/index"
                            class="btn-chapter-cancel"
                        >
                            Cancel
                        </a>

                        <button
                            type="submit"
                            class="btn-chapter-save"
                        >
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

<%- include("../../partials/footer") %>

<script src="/tinymce/tinymce.min.js"></script>

<script>
    tinymce.init({
        language: "pt_BR",
        selector: "#description, #appearance, #personality, #story, #goals, #state",
        license_key: "gpl",
        height: 300,
        menubar: true,
        plugins: [
            "advlist autolink link image lists print preview hr searchreplace wordcount fullscreen insertdatetime media save table paste emoticons"
        ],
        toolbar:
            "undo redo | blocks | bold italic underline | " +
            "alignleft aligncenter alignright | " +
            "bullist numlist | link image | table | fullscreen",
        content_style:
            "body { font-family: Arial, Helvetica, sans-serif; " +
            "font-size: 14px; line-height: 1.7; }"
    });
</script>