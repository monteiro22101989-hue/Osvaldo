
<%- include("../partials/header") %>
<%- include("../partials/navbar") %>
<div class="narneiro-background">
<div class="character-read-page">
    <div class="character-read-container">

        <a href="/character/index" class="character-read-back">
            &larr; Voltar para os personagens
        </a>

        <article class="character-scroll">

            <div class="character-scroll-ornament">
                
            </div>

            <header class="character-read-header">
                <span class="character-read-label">
                    The Chronicles of Narneiro
                </span>

                <h1 class="character-read-title">
                    <%= characters.name %>
                </h1>

                <span class="character-read-id">
                    Character #<%= characters.id %>
                </span>

                <% if (characters.nickname) { %>
                    <p class="character-read-nickname">
                        "<%= characters.nickname %>"
                    </p>
                <% } %>
            </header>
             <% if (characters.image) { %>
                <div class="character-read-image">
                    <img
                        src="<%= characters.image %>"
                        alt="Imagem de <%= characters.name %>"
                    >
                </div>
            <% } %>
            <section class="character-read-section">
                <h2>Appearance</h2>
                <div class="character-read-content">
                    <%- characters.appearance || "No information available." %>
                </div>
            </section>

            <section class="character-read-section">
                <h2>Personality</h2>
                <div class="character-read-content">
                    <%- characters.personality || "No information available." %>
                </div>
            </section>

            <section class="character-read-section">
                <h2>Story</h2>
                <div class="character-read-content">
                    <%- characters.story || "No information available." %>
                </div>
            </section>

            <section class="character-read-section">
                <h2>Goals</h2>
                <div class="character-read-content">
                    <%- characters.goals || "No information available." %>
                </div>
            </section>

            <section class="character-read-section">
                <h2>Current State</h2>
                <div class="character-read-content">
                    <%- characters.state || "No information available." %>
                </div>
            </section>

            <section class="character-read-section">
                <h2>State in the Story</h2>
                <div class="character-read-content">
                    <%- characters.state_on_story || "No information available." %>
                </div>
            </section>

            <footer class="character-read-footer">
                End of character record
                <span>❦</span>
            </footer>

        </article>

    </div>
</div>
</div>
<%- include("../partials/footer") %>
