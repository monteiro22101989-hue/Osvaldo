<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<% if (message) { %>
    <div class="alert alert-<%= messageType %> text-center mx-auto summary-read-message">
        <%= message %>
    </div>
<% } %>

<div class="summary-read-page">
    <div class="summary-read-container">

        <a href="/summary/index" class="summary-read-back">
            &larr; Voltar para os resumos
        </a>

        <article class="summary-scroll">

            <div class="summary-scroll-ornament">
                
            </div>

            <header class="summary-read-header">
                <span class="summary-read-label">
                    The Chronicles of Narneiro
                </span>

                <h1 class="summary-read-title">
                    <%= summary.title %>
                </h1>

                <span class="summary-read-id">
                    Summary #<%= summary.id %>
                </span>
            </header>

            <section class="summary-read-section">
                <h2>Content</h2>

                <div class="summary-read-content">
                    <%- summary.content || "No information available." %>
                </div>
            </section>

            <section class="summary-read-section">
                <h2>Type</h2>

                <div class="summary-read-content">
                    <%= summary.type || "No information available." %>
                </div>
            </section>

            <section class="summary-read-section">
                <h2>Order</h2>

                <div class="summary-read-content">
                    <%= summary.order ?? "No information available." %>
                </div>
            </section>

            <footer class="summary-read-footer">
                End of summary
                <span>❦</span>
            </footer>

        </article>

    </div>
</div>

<%- include("../partials/footer") %>
