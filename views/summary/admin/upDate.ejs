
<%- include("../../partials/header") %>
<%- include("../../partials/navbar") %>


<div class="container">
    
    <hr>
    <div class="card-header">
        <h1>create resumo for your history</h1>
    </div>
    <div class="card-body">
        <form action="/summary/admin/upDate" method="post">
            <div class="form-group">
                <labe>Title</labe>
                <input class="form-control" type="text" id="title" value="<%-summary.title%>" name="title">
            </div>
            <div class="form-group">
                <label>content</label>
                <input class="form-control" type="text" id="content" name="content" value="<%-summary.content%>">
            </div>
            <div class="form-group">
                <label>type</label>
                <input class="form-control" type="text" id="type" value="<%-summary.type%>" name="type">
            </div>
            <div>
                <label>order</label>
                <input class="form-control" type="number" id="order" name="order" value="<%-summary.order%>" >
            </div>
            <input type="hidden" name="id" value="<%-summary.id%>">
            <button type="submit" class="btn btn-primary my-2">Send</button>
        </form>
    </div>




</div>



<%- include("../../partials/footer") %>