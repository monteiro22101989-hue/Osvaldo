<%-include("../../partials/header")%>
<%-include("../../partials/navbar")%>
<body>
    <div class="container">
        <div class="card-header my-3">
            <h1>creat a new chapter</h1>
        </div>
        <div class="card-body">
            <form action="/chapter/admin/save" method="POST">
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" class="form-control" id="title" name="title">
                </div>
                <div class="form-group">
                    <label for="content">Content</label>
                    <textarea class="form-control" id="content" name="content"></textarea>
                </div>
                 <div class="form-group">
                    <label for="ordem">Order</label>
                    <input type="number" class="form-control" id="ordem" name="ordem" placeholder="Enter the order of the chapter">
                </div>

                <!--character selection here-->
                <div class="form-group">
                        <label>Characters</label>

                        <% characters.forEach(character => { %>
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="characters[]"
                                    value="<%= character.id %>"
                                    id="character-<%= character.id %>">

                                <label
                                    class="form-check-label"
                                    for="character-<%= character.id %>">
                                    <%= character.name %>
                                </label>
                            </div>
                        <% }) %>
                    </div>

                <button type="submit" class="btn btn-primary">Save Chapter</button>
            </form>

        </div>
    </div>
</body>


<%-include("../../partials/footer")%>
<script src="/tinymce/tinymce.min.js"></script>
<script>
    tinymce.init({
        language: 'pt_BR', //<---fizemos o download  da lingua e colocamos na pasta e depois mudamos aqui-->
        selector: "#content",
        license_key: 'gpl', // <--- ADICIONE ESTA LINHA PARA REMOVER O AVISO da chave
        plugins: [
            'advlist autolink link image lists print preview hr searchreplace wordcount fullscreen insertdatetime media save table paste emoticons'
        ]

    })
</script>