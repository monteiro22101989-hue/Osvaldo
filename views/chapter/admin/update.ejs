
<%- include("../../partials/header") %>
<%- include("../../partials/navbar")%>

<body>

    <div class="chapter-edit-page">

        <div class="chapter-edit-container">

            <!-- Page heading -->
            <div class="chapter-edit-header">
                <span class="chapter-edit-eyebrow">
                    CHAPTER MANAGEMENT
                </span>

                <h1>Edit Chapter</h1>

                <p>
                    Update your chapter details and content.
                </p>
            </div>

            <!-- Edit form -->
            <div class="chapter-edit-panel">

                <form action="/chapter/save" method="POST">

                    <input
                        type="hidden"
                        name="id"
                        value="<%= chapter.id %>"
                    >

                    <!-- Chapter title and order -->
                    <div class="chapter-edit-grid">

                        <div class="chapter-edit-group">
                            <label for="title">
                                Chapter Title
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                value="<%= chapter.title %>"
                                placeholder="Enter the chapter title"
                                required
                            >
                        </div>

                        <div class="chapter-edit-group">
                            <label for="ordem">
                                Chapter Order
                            </label>

                            <input
                                type="number"
                                class="form-control"
                                id="ordem"
                                name="ordem"
                                value="<%= chapter.order %>"
                                placeholder="Enter chapter order"
                                required
                            >
                        </div>

                    </div>

                    <!-- Chapter content -->
                    <div class="chapter-edit-group chapter-edit-content">

                        <label for="content">
                            Chapter Content
                        </label>

                        <textarea
                            class="form-control"
                            id="content"
                            name="content"
                        ><%= chapter.content %></textarea>

                        <small>
                            Write and format your chapter content below.
                        </small>

                    </div>

                    <!-- Character selection -->
                    <div class="chapter-edit-characters">

                        <div class="chapter-edit-section-heading">
                            <h2>Chapter Characters</h2>

                            <p>
                                Select all characters featured in this chapter.
                            </p>
                        </div>

                        <div class="chapter-edit-character-list">

                            <% characters.forEach(character => { %>

                                <label
                                    class="chapter-edit-character"
                                    for="character-<%= character.id %>"
                                >

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="characters[]"
                                        value="<%= character.id %>"
                                        id="character-<%= character.id %>"
                                        <%= chapter.characters &&
                                        chapter.characters.some(c => c.id == character.id)
                                        ? "checked" : "" %>
                                    >

                                    <span>
                                        <%= character.name %>
                                    </span>

                                </label>

                            <% }) %>

                        </div>

                    </div>

                    <!-- Form actions -->
                    <div class="chapter-edit-actions">

                        <a
                            href="/chapter/index"
                            class="btn-chapter-cancel"
                        >
                            Cancel
                        </a>

                        <button
                            type="submit"
                            class="btn-chapter-save"
                        >
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

<%- include("../../partials/footer") %>

<script src="/tinymce/tinymce.min.js"></script>

<script>
    tinymce.init({
        selector: "#content",
        license_key: "gpl",
        height: 400,
        menubar: true,
        plugins: [
            "advlist autolink link image lists print preview hr searchreplace wordcount fullscreen insertdatetime media save table paste emoticons"
        ],
        toolbar:
            "undo redo | blocks | bold italic underline | " +
            "alignleft aligncenter alignright | " +
            "bullist numlist | link image | table | fullscreen",
        content_style:
            "body { font-family: Arial, Helvetica, sans-serif; " +
            "font-size: 14px; line-height: 1.7; }"
    });
</script>
