
<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<div class="narneiro-background">
<div class="chapter-read-page">
    <HR>
    <div class="chapter-read-container">

        <a href="/chapter/index" class="chapter-read-back">
            &larr; Back to Chapters
        </a>

        <article class="chapter-scroll">

            <div class="chapter-scroll-ornament">
                
            </div>

            <header class="chapter-read-header">
                <span class="chapter-read-label">
                    The Chronicles of Narneiro
                </span>

                <h1 class="chapter-read-title">
                    <%= chapters.title %>
                </h1>

                <span class="chapter-read-id">
                    Chapter #<%= chapters.order %>
                </span>
            </header>

            <div class="chapter-read-content">
                <%- chapters.content %>
            </div>
            
            
            <div class="chapter-read-characters">

                <h2>Characters in this Chapter</h2>

                <div class="chapter-character-list">

                    <% if (chapters.characters && chapters.characters.length > 0) { %>

                        <% chapters.characters.forEach(character => { %>

                            <a class="chapter-read-character-link"
                            href="/character/read/<%= character.id %>">
                                <%= character.name %>
                            </a>

                        <% }) %>

                    <% } else { %>

                        <span class="chapter-no-characters">
                            No characters
                        </span>

                    <% } %>

                </div>

            </div>



            <footer class="chapter-read-footer">
                End of chapter
                <span>❦</span>
            </footer>

        </article>


    </div>
</div>
</div>
<%- include("../partials/footer") %>