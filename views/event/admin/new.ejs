<%-include("../../partials/header")%>
<%-include("../../partials/navbar")%>
 <%if(message){%>
        <div class="alert alert-<%-messageType%> text-center mx-auto">
            <%-message%>
        </div>
        
    <%}%>
<div class="container">
    <div class="card-header">
        <h1>Create new event</h1>
    </div>
    <div class="card-body">
        <form action="/event/admin/save" method="POST">
            <div class="form-group">
                <label>title</label>
                <input type="text" class="form-control" id="title" name="title">
            </div>
            <div class="form-group">
                <labe>description</labe>
                <input type="text" class="form-control" id="description" name="description">
            </div>
            <div class="form-group">
                <label>time</label>
                <input type="text" class="form-control" id="time" name="time">
            </div>
            <div class="form-group">
                <label>importance</label>
                <input type="text" class="form-control" name="importance">
            </div>
            <div class="form-group">
                <label>local</label>
                <input type="text" class="form-control" name="local">
            </div>
            <div class="form-group my-2">
                <label>observation</label>
                <input type="text" class="form-control" id="observation" name="observation">
            </div>
            <button type="submit" class="btn btn-primary">Send event</button>
        </form>

    </div>


</div>
<%-include("../../partials/footer")%>

<script src="/tinymce/tinymce.min.js"></script>
<script>
    tinymce.init({
        language: 'pt_BR', //<---fizemos o download  da lingua e colocamos na pasta e depois mudamos aqui-->
        selector: "#content, #description, #observation",
        license_key: 'gpl', // <--- ADICIONE ESTA LINHA PARA REMOVER O AVISO da chave
        plugins: [
            'advlist autolink link image lists print preview hr searchreplace wordcount fullscreen insertdatetime media save table paste emoticons'
        ]
    })
</script>