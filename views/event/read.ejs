```ejs
<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<div class="event-read-page">
    <div class="event-read-container">

        <a href="/event/index" class="event-read-back">
            &larr; Voltar para os eventos
        </a>

        <article class="event-scroll">

            <div class="event-scroll-ornament">
                ✦ ❧ ✦
            </div>

            <header class="event-read-header">
                <span class="event-read-label">
                    The Chronicles of Narneiro
                </span>

                <h1 class="event-read-title">
                    <%= events.title %>
                </h1>

                <span class="event-read-id">
                    Event #<%= events.id %>
                </span>
            </header>

            <section class="event-read-section">
                <h2>Description</h2>

                <div class="event-read-content">
                    <%- events.description || "No information available." %>
                </div>
            </section>

            <section class="event-read-section">
                <h2>Importance</h2>

                <div class="event-read-content">
                    <%- events.importance || "No information available." %>
                </div>
            </section>

            <section class="event-read-section">
                <h2>Location</h2>

                <div class="event-read-content">
                    <%- events.local || "No information available." %>
                </div>
            </section>

            <section class="event-read-section">
                <h2>Observations</h2>

                <div class="event-read-content">
                    <%- events.observation || "No information available." %>
                </div>
            </section>

            <footer class="event-read-footer">
                End of event record
                <span>❦</span>
            </footer>

        </article>

    </div>
</div>

<%- include("../partials/footer") %>
```